{
  "name": "xiaomi-camera-desktop",
  "version": "0.1.2",
  "description": "简单易用的小米摄像头桌面客户端",
  "author": "Ray8876",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "engine": "node scripts/build-engine.cjs",
    "ffmpeg": "node scripts/fetch-ffmpeg.cjs",
    "build": "electron-builder",
    "check": "node --check desktop/main.cjs && node --check ui/app.js"
  },
  "dependencies": {
    "archiver": "7.0.1",
    "ws": "8.18.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "@playwright/test": "1.56.1",
    "adm-zip": "0.5.16",
    "electron": "39.8.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "io.github.ray8876.xiaomi-camera-desktop",
    "productName": "Mi Camera Desktop",
    "artifactName": "Mi-Camera-Desktop-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "ui/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "engine/LICENSE",
        "to": "licenses/go2rtc-LICENSE"
      },
      {
        "from": "resources/ffmpeg-LICENSE.txt",
        "to": "licenses/ffmpeg-LICENSE.txt"
      },
      {
        "from": "licenses",
        "to": "licenses/dependencies-notices"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "docs/FFMPEG-SOURCE.md",
        "to": "licenses/FFMPEG-SOURCE.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "resources/win32-${arch}",
          "to": "engine"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "sign": "scripts/sign-mac.cjs",
      "binaries": [
        "Contents/Resources/engine/go2rtc",
        "Contents/Resources/engine/ffmpeg"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "extraResources": [
        {
          "from": "resources/darwin-${arch}",
          "to": "engine"
        }
      ]
    },
    "dmg": {
      "title": "Mi Camera Desktop",
      "sign": false
    },
    "publish": {
      "provider": "github",
      "owner": "Ray8876",
      "repo": "xiaomi-camera-desktop"
    }
  }
}
